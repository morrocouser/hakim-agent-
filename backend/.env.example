# ============================================================
# HakimAgent / AXIOM — Environment variables template
# Copy to `.env` and fill in the values. NEVER commit `.env`.
# ============================================================

# ---- REQUIRED: JWT secret for authentication ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The server REFUSES to start if this is not set.
HAKIM_JWT_SECRET=

# ---- LLM provider (OpenRouter or Google Gemini) ----
# Get a key at https://openrouter.ai/keys or Google AI Studio
OPENROUTER_API_KEY=
AXIOM_LLM_BASE_URL=https://openrouter.ai/api/v1
# AXIOM_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Google Gemini / AI Studio
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ---- Tool loop (function calling) ----
# 1 = enable ReAct tool loop, 0 = single-shot
AXIOM_TOOL_LOOP=1

# ---- Web search (Brave Search) ----
# Optional. If empty, web_search tool uses Google/DuckDuckGo fallback.
WEB_SEARCH_API_KEY=

# ---- Gmail & SMTP/IMAP Connector ----
# Pour envoyer et lire de vrais e-mails via Gmail :
# 1. Activez l'authentification à 2 facteurs sur votre compte Google
# 2. Générez un mot de passe d'application sur: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# SMTP personnalisé (optionnel, defaults: smtp.gmail.com:465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# IMAP personnalisé (optionnel, defaults: imap.gmail.com:993)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ---- YouTube Data API v3 ----
# Utilise GOOGLE_API_KEY par défaut ou une clé dédiée
YOUTUBE_API_KEY=

# ---- Telegram Bot Connector ----
# Créez un bot via @BotFather sur Telegram pour obtenir le token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Discord Webhook Connector ----
# Créez un Webhook dans les paramètres de votre salon Discord
DISCORD_WEBHOOK_URL=

# ---- GitHub & MCP Connectors ----
GITHUB_PERSONAL_ACCESS_TOKEN=
SLACK_BOT_TOKEN=

# ---- Server host/port ----
HOST=0.0.0.0
PORT=8000

# ---- Rate limiting ----
AXIOM_RATE_LIMIT_PER_MIN=60

# ---- n8n Automation Connector ----
# URL de votre instance n8n (locale ou cloud) et clé d'API
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_URL=

# ---- Figma Design Connector ----
# Personal Access Token depuis Compte Figma > Settings > Security > Personal access tokens
FIGMA_ACCESS_TOKEN=
FIGMA_API_KEY=
FIGMA_FILE_KEY=

# ---- Notion & Linear Connectors ----
NOTION_API_KEY=
LINEAR_API_KEY=

# ---- Stripe Payment & Subscriptions ----
# Obtenez vos clés sur https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret du Webhook (obtenu via 'stripe listen' ou dans le dashboard webhooks)
STRIPE_WEBHOOK_SECRET=
# Optionnel : ID des tarifs récurrents Stripe si créés dans le dashboard
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
# URL du frontend pour les redirections Stripe Checkout & Customer Portal
FRONTEND_URL=http://localhost:3000

