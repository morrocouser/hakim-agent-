# ============================================================
# HakimAgent / AXIOM — Environment variables template
# Copy to `.env` and fill in the values. NEVER commit `.env`.
# ============================================================

# ---- REQUIRED: JWT secret for authentication ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The server REFUSES to start if this is not set.
HAKIM_JWT_SECRET=

# ---- Administrateurs (liste de usernames séparés par des virgules) ----
# Seuls ces comptes peuvent : exécuter des commandes slash qui lancent un
# processus (/bash, /git, /docker, /npm...) et modifier la mémoire / le journal
# d'erreurs globaux. Vide = personne (fail-closed).
HAKIM_ADMIN_USERS=

# ---- LLM provider (OpenRouter) ----
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
AXIOM_LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional: override the default model selected by the scoring router
# AXIOM_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---- Tool loop (function calling) ----
# 1 = enable ReAct tool loop, 0 = single-shot
AXIOM_TOOL_LOOP=1

# ---- Web search (Brave Search) ----
# Optional. If empty, web_search tool returns a "disabled" message.
# WEB_SEARCH_API_KEY=

# ---- 21st.dev (UI component search, optional) ----
# Get a key at https://21st.dev/settings/api-keys
# API_KEY_21ST=

# ---- Error log persistence ----
# Optional. Defaults to ~/.axiom/error_log.jsonl
# ERROR_LOG_PATH=

# ---- SQLite database path ----
# Optional. Defaults to backend/axiom/data/apex.db
# AXIOM_DB_PATH=

# ---- Server host/port ----
HOST=0.0.0.0
PORT=8000

# ---- Rate limiting ----
# AXIOM_RATE_LIMIT_PER_MIN=60      # max requests per minute per IP
# AXIOM_RATE_LIMIT_REDIS_URL=      # e.g. redis://localhost:6379/0 — enables distributed mode

# ---- Sandbox d'exécution de code (optionnel) ----
# Figer les images par digest en production, ex: python:3.11-slim@sha256:...
# HAKIM_SANDBOX_IMAGE_PYTHON=
# HAKIM_SANDBOX_IMAGE_JAVASCRIPT=
